# ------------------------------------------------------------------
# MIS Support Hub — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ------------------------------------------------------------------

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with:  npx auth secret   (or)  openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (Google Cloud Console → Credentials → OAuth client, Web app)
# Authorized redirect URI:  {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OPTIONAL extra sign-in filter: comma-separated email domains.
# Empty = no domain filter, and that is the expected setup here — it is NOT what
# keeps strangers out. The app is invite-only (§7): you can only sign in if an admin
# already created your account. A domain filter is useless for this org anyway (the
# team uses personal Gmail); set it only if you ever move to a Workspace domain.
ALLOWED_EMAIL_DOMAINS=""

# Comma-separated emails bootstrapped to MIS_ADMIN on first sign-in.
# ALSO the invite-only bootstrap (§7): these addresses are the ONLY ones allowed to
# sign in without an existing users row. Set at least one before the first deploy —
# against an empty users table, nothing else can get in.
ADMIN_EMAILS=""

# Vercel Blob (Storage → create store → read/write token)
BLOB_READ_WRITE_TOKEN=""

# Resend (email). If unset, emails are skipped (best-effort, non-fatal).
RESEND_API_KEY=""
EMAIL_FROM="MIS Support <onboarding@resend.dev>"

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only: set to "true" to stub a session (bypasses auth) so the app shell
# renders before Google OAuth is set up. Never honoured in production.
DEV_AUTH_STUB=""
# Dev-only: override the stub role to test role-gated UI.
# One of USER | MIS_STAFF | MIS_ADMIN (defaults to MIS_ADMIN).
DEV_STUB_ROLE=""
# Dev-only: impersonate a seeded user (a real users.id) to see their own tickets.
DEV_STUB_ID=""
